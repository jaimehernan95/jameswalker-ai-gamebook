# Server-side Gemini API key (optional for local dev — falls back to deterministic offline rubric if blank)
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Public deployment URL (used for canonical metadata, QR links, and callbacks)
APP_URL=https://jameswalker-ai-gamebook.onrender.com

# Server-side author passcode protecting POST /api/dispatches (recommended for production)
AUTHOR_DISPATCH_SECRET=

# HTTP server port (defaults to 3000)
PORT=3000
